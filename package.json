{
  "name": "vision",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Capture the images you see in things, then let the browser sharpen and animate them - fully offline, no server.",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:vocabulary": "tsx tools/build-vocabulary.ts",
    "verify:render": "node tools/verify-render.mjs",
    "verify:video": "node tools/verify-video.mjs",
    "diagnose:render": "node tools/diagnose-render.mjs",
    "benchmark": "node tools/benchmark.mjs",
    "playwright:install": "playwright install chromium",
    "generate:assets": "pwa-assets-generator"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "dexie": "4.4.6",
    "mediabunny": "1.59.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@webgpu/types": "0.1.74",
    "fake-indexeddb": "^6.2.5",
    "oxlint": "^1.85.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  }
}
